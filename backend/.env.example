# Database
DATABASE_URL=

# Server
PORT=8080
NODE_ENV=development

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Frontend (CORS + email links + Midtrans redirects)
FRONTEND_URL=http://localhost:3000

# Public backend URL (optional, for media links)
BASE_URL=http://localhost:8080

# SMTP (optional — password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Midtrans (use sandbox keys; set MIDTRANS_IS_PRODUCTION=false for demo)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# AWS S3 (optional — media asset uploads)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Demo seed (optional — used by prisma db seed)
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=
